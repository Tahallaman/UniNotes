# ── Dependencies ─────────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────────
dist/

# ── Browser auth profiles (Google/Panopto session cookies) ───────
browser-data/

# ── Temporary files ───────────────────────────────────────────────
temp/

# ── Logs ──────────────────────────────────────────────────────────
logs/

# ── Database ──────────────────────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm

# ── Your lectures and everything derived from them ───────────────
# Videos, notes and exports are your own coursework: they routinely quote
# named people, and lecture recordings are usually your institution's
# copyright. None of it belongs in a repository you might share.
Incoming/
Lectures/
Exports/

# ── Lectures you've told the pipeline to skip (real lecture titles) ──
ignored-lectures.txt

# ── GUI settings overrides (machine-specific; defaults live in config.ts) ──
settings.json

# ── Generated scheduled-task launchers (contain absolute paths) ───
scripts/scheduled/

# ── Personal todo (auto-generated by pipeline) ────────────────────
TODO.md

# ── Tool data ─────────────────────────────────────────────────────
.claude/
.playwright-mcp/

# ── OS / editor ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.env
