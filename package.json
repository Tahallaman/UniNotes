{
  "name": "uninotes",
  "version": "1.0.0",
  "description": "Turns Panopto lecture recordings into study notes with Gemini — CLI and local control panel",
  "keywords": [
    "panopto",
    "lecture-notes",
    "gemini",
    "vertex-ai",
    "playwright",
    "study-notes"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tahallaman/UniNotes.git"
  },
  "bugs": {
    "url": "https://github.com/Tahallaman/UniNotes/issues"
  },
  "homepage": "https://github.com/Tahallaman/UniNotes#readme",
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "playwright install msedge",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/main.ts",
    "gui": "tsx scripts/gui.ts",
    "scan": "tsx scripts/scan-panopto.ts",
    "setup-auth:panopto": "tsx src/main.ts --auth panopto",
    "setup-auth:gemini": "tsx src/main.ts --auth gemini",
    "migrate": "tsx scripts/migrate-to-subfolders.ts",
    "export": "tsx scripts/export-notes.ts",
    "pretty": "tsx scripts/run-pretty.ts",
    "local": "tsx scripts/process-local.ts",
    "probe:vertex": "tsx scripts/probe-vertex.ts",
    "probe:browser": "tsx scripts/probe-browser.ts",
    "test:attach": "tsx scripts/test-attachment-detect.ts",
    "test:timestamps": "tsx scripts/test-timestamps.ts",
    "test:blank": "tsx scripts/test-blank-detect.ts",
    "test:weeks": "tsx scripts/test-weeks.ts",
    "test:explain": "tsx scripts/test-explain.ts",
    "test:export-names": "tsx scripts/test-export-names.ts",
    "test:ledger": "tsx scripts/test-export-ledger.ts",
    "test:highlights": "tsx scripts/test-highlights.ts",
    "test:captions": "tsx scripts/test-captions.ts",
    "sync": "tsx scripts/sync-workspace.ts",
    "probe:panopto-view": "tsx scripts/probe-panopto-view.ts",
    "test": "npm run typecheck && npm run test:attach && npm run test:timestamps && npm run test:blank && npm run test:weeks && npm run test:explain && npm run test:export-names && npm run test:ledger && npm run test:highlights && npm run test:captions"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@google/genai": "^2.11.0",
    "better-sqlite3": "^11.7.0",
    "katex": "^0.16.11",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
