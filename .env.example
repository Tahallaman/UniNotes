# Optional environment overrides. Copy to .env and edit, or just export these in
# your shell — nothing reads a .env file automatically, so this is a reference
# sheet as much as a template.
#
# Everything here can also be set in config.ts (with the reasoning attached) or,
# for most of it, in the control panel's Settings tab. Environment variables win
# over both, which is what makes them useful for a scheduled task or CI.

# ── Institution ───────────────────────────────────────────────────────────────
# Your Panopto tenant, scheme and host only, no trailing slash. Required for
# anything that touches Panopto. It's the first part of the address you see
# while watching a recording.
UNINOTES_PANOPTO_URL=https://yourschool.hosted.panopto.com

# ── Which backend handles each stage ──────────────────────────────────────────
# "browser" drives your signed-in gemini.google.com session (free, slower).
# "api" calls Gemini on Vertex AI (billed, parallelises far better).
UNINOTES_UPLOADER=browser
UNINOTES_PRETTY=api

# ── Google Cloud (only needed if a stage above is "api") ──────────────────────
GOOGLE_CLOUD_PROJECT=my-project-123456
GOOGLE_CLOUD_LOCATION=global

# Where video chunks are staged for Vertex to read. Leave unset to derive
# "uninotes-<project>" and create it on first use.
# UNINOTES_GCS_BUCKET=
# A real Cloud Storage region — unlike Vertex, GCS rejects "global".
# UNINOTES_GCS_BUCKET_LOCATION=us-central1
